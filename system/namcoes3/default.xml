<!-- ARCADE collection -->

<theme>
	<formatVersion>7</formatVersion>
	
	<view name="system">

		<image name="avatar" extra="static">
			<origin>0.8 0.6</origin>	
			<size>0.4317708 0.487037</size>									
			<pos>-0.5 0.6</pos>	
			<scale>0.9</scale>
			<linearSmooth>true</linearSmooth>					
			<storyboard>
				<!-- 1. Movimiento principal hacia la derecha (llega a 0.55 en 800ms) -->
				<animation property="x" to="0.55" begin="0" duration="800" mode="easeOut"/>
				
				<!-- 2. Retroceso sutil a la izquierda al frenar (del ms 800 al 1100 se desplaza a 0.53) -->
				<animation property="x" to="0.53" begin="800" duration="300" mode="easeInOut"/>
				
				<!-- 3. Rebote final ajustándose a la posición central definitiva (del ms 1100 al 1400 vuelve a 0.54) -->
				<animation property="x" to="0.54" begin="1100" duration="300" mode="easeOut"/>

				<!-- 4. Zoom In (comienza al terminar el desplazamiento principal, del ms 800 al 1400) -->
				<animation property="scale" to="1.15" begin="800" duration="600" mode="easeOut"/>
				
				<!-- 5. Zoom Out (del ms 1400 al 2000 regresa a escala normal de reposo) -->
				<animation property="scale" to="1.0" begin="1400" duration="600" mode="easeInOut"/>
			</storyboard>					

		</image>
		
	</view>
</theme>